{
  "name": "cv-ready-bot",
  "version": "0.1.0",
  "private": true,
  "description": "CV Ready: WhatsApp CV builder bot (skeleton)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "chat": "tsx src/dev/chat.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}

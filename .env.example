# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- WhatsApp Cloud API (Meta developer dashboard > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=EAAG...                # temporary (24h) or system-user access token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
WHATSAPP_APP_SECRET=your-app-secret   # App settings > Basic > App secret (used to verify webhook signatures)
GRAPH_API_VERSION=v26.0

# --- Supabase (Project settings > API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # server-only, never ship to a client

# --- Redis ---
REDIS_URL=redis://localhost:6379

# Bump when the consent text changes, so you know who agreed to which version
CONSENT_VERSION=2026-11-v1
